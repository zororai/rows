# Used when the whole project is deployed into public_html (e.g. Hostinger's
# GitHub deployment). Sends every request into Laravel's public/ folder so the
# app runs, and .env, the database and the source code can never be downloaded.

Options -Indexes

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(.*)$ public/$1 [L]
</IfModule>
